# ByteDance ad network (穿山甲/巨量) — 源自 fmz200/wool_scripts 番茄小说段。
# 这是共享广告基建，不是某个应用的专属规则；对番茄小说等字节应用同样生效。
# 顺序敏感：可见的 get_ads 先返回空 JSON；其余请求由随后的本地域名规则拒绝。
# 整域拒绝不依赖 HTTPS 解密，避免 settings/stats、竞价或 HTTP/3 绕过。
URL-REGEX,^https?://[^/]+\.pangolin-sdk-toutiao(-b|1)?\.com/api/ad/union/sdk/get_ads/?,REJECT-DICT
DOMAIN-SUFFIX,pangolin-sdk-toutiao-b.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao1.com,REJECT
# 广告素材图片返回空图；投放包与上报断开连接。
URL-REGEX,^https?://[^/]+\.pstatp\.com/(obj|img)/(ad|web\.business\.image)/,REJECT-IMG
URL-REGEX,^https?://[^/]+\.pstatp\.com/obj/ad-pattern/renderer,REJECT-IMG
URL-REGEX,^https?://[^/]+\.byteimg\.com/web\.business\.image,REJECT-IMG
URL-REGEX,^https?://[^/]+\.(pstatp|byteimg)\.com/(obj/|img/)?ad-app-package,REJECT
URL-REGEX,^https?://[^/]+\.pstatp\.com/bytecom/resource/track_log/src/,REJECT
URL-REGEX,^https?://gurd\.snssdk\.com/src/server/v3/package,REJECT
URL-REGEX,^https?://dsp\.toutiao\.com/api/xunfei/ads/,REJECT-200
