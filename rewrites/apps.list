# Curated static app coverage derived from fmz200/wool_scripts.
# Only ad, promotion, sponsor, or watermark endpoints are included.


# Zhihu and Xiaohongshu
URL-REGEX,^https://api\.zhihu\.com/commercial_api/(answer/[0-9]+/bottom-v2|article/[0-9]+/bottom-v2|banners_v3/app_topstory_banner|launch_v2|real_time_launch_v2),REJECT-DICT
URL-REGEX,^https://api\.zhihu\.com/ad-style-service/request,REJECT-DICT
URL-REGEX,^https?://www\.xiaohongshu\.com/api/sns/v[0-9]+/ads/resource,REJECT-DICT
URL-REGEX,^https?://ci\.xiaohongshu\.com/system_config/watermark,REJECT-IMG

